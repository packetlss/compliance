{
  "apiVersion": "compliance.example/v1",
  "kind": "Control",
  "metadata": {
    "id": "iam.integration.required",
    "version": 1
  },
  "spec": {
    "title": "IAM service integrations satisfy policy",
    "purpose": "Verify that required identity-service conditions and their governed relationships are supported by attributable evidence.",
    "entrypoint": "data.compliance.controls.iam_integration_required.evaluate",
    "applies_to": [
      "linux-host"
    ],
    "evidence": [
      {
        "id": "service",
        "type": "iam.service.observation/v1",
        "inputs_schema": {
          "type": "object",
          "required": [
            "service",
            "condition"
          ],
          "additionalProperties": false,
          "properties": {
            "service": {
              "type": "string",
              "minLength": 1
            },
            "condition": {
              "type": "string",
              "minLength": 1
            }
          },
          "$id": "https://compliance.example/inputs/iam.integration.required/service"
        }
      },
      {
        "id": "relationship",
        "type": "iam.integration.observation/v1"
      }
    ],
    "parameters_schema": "parameters.schema.json",
    "defaults": {
      "severity": "high",
      "remediation": "Obtain a qualifying attributable observation for the exact policy dependency."
    }
  }
}
