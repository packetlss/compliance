{
  "apiVersion": "compliance.example/v1",
  "kind": "Control",
  "metadata": {
    "id": "iam.integration.required",
    "version": 1
  },
  "spec": {
    "title": "IAM service integrations satisfy policy",
    "purpose": "Verify that the exact subject is integrated with the IAM service designated by governed policy.",
    "entrypoint": "data.compliance.controls.iam_integration_required.evaluate",
    "applies_to": [
      "linux-host"
    ],
    "evidence": [
      {
        "id": "relationship",
        "type": "iam.integration.observation/v1",
        "inputs_schema": {
          "type": "object",
          "required": [
            "service"
          ],
          "additionalProperties": false,
          "properties": {
            "service": {
              "type": "string",
              "minLength": 1
            }
          },
          "$id": "https://compliance.example/schemas/controls/iam.integration.required/evidence/relationship/inputs/v1.schema.json"
        }
      }
    ],
    "parameters_schema": "parameters.schema.json",
    "defaults": {
      "severity": "high",
      "remediation": "Obtain a qualifying attributable observation for the exact policy dependency."
    }
  }
}
