{
  "apiVersion": "compliance.example/v1",
  "kind": "Control",
  "metadata": {
    "id": "aws.s3.account_public_access_block_required",
    "version": 1
  },
  "spec": {
    "entrypoint": "data.compliance.controls.aws.s3_account_public_access_block_required.evaluate",
    "applies_to": ["aws-account"],
    "evidence": [
      {
        "type": "aws.s3.account-public-access-block/v1",
        "required": true,
        "max_age": "24h"
      }
    ],
    "parameters_schema": "parameters.schema.json",
    "defaults": {
      "severity": "high",
      "remediation": "Enable all four Amazon S3 account-level Block Public Access settings through the approved cloud configuration workflow."
    }
  }
}
