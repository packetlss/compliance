{
  "apiVersion": "compliance.example/v1",
  "kind": "Control",
  "metadata": {"id": "organization.awareness-training.complete", "version": 1},
  "spec": {
    "title": "Awareness-training completion is established",
    "purpose": "Verify reported completion for every member of the exact supplied required-population basis.",
    "entrypoint": "data.compliance.controls.organization_awareness_training_complete.evaluate",
    "applies_to": ["entity"],
    "evidence": [{
      "id": "training_report", "type": "organization.awareness-training/v1",
      "inputs_schema": {
        "$id": "https://compliance.example/schemas/controls/organization.awareness-training.complete/evidence/training_report/inputs/v1.schema.json",
        "type": "object", "required": ["programme_id", "population_basis_id", "maximum_report_age_seconds"], "additionalProperties": false,
        "properties": {
          "programme_id": {"type": "string", "minLength": 1},
          "population_basis_id": {"type": "string", "minLength": 1},
          "maximum_report_age_seconds": {"type": "integer", "minimum": 1}
        }
      }
    }],
    "parameters_schema": "parameters.schema.json",
    "defaults": {"severity": "high", "remediation": "Obtain a current, attributable awareness-training report with an established required population and completion count."}
  }
}
