{
  "apiVersion": "compliance.example/v1",
  "kind": "Control",
  "metadata": {
    "id": "organization.assertion.required",
    "version": 1
  },
  "spec": {
    "entrypoint": "data.compliance.controls.organization_assertion_required.evaluate",
    "applies_to": [
      "entity"
    ],
    "evidence": [
      {
        "id": "assertion",
        "type": "organization.assertion/v1",
        "required": true,
        "inputs_schema": {
          "type": "object",
          "required": [
            "scheme"
          ],
          "additionalProperties": false,
          "properties": {
            "scheme": {
              "type": "string",
              "minLength": 1
            }
          },
          "$id": "https://compliance.example/inputs/organization.assertion.required/assertion"
        }
      }
    ],
    "parameters_schema": "parameters.schema.json",
    "defaults": {
      "severity": "high",
      "remediation": "Obtain a qualifying attributable observation for the exact policy dependency."
    }
  }
}
