{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["section", "setting", "expected"],
  "additionalProperties": false,
  "properties": {
    "section": {"type": "string", "minLength": 1},
    "setting": {"type": "string", "minLength": 1},
    "expected": {
      "oneOf": [
        {"type": "boolean"},
        {"type": "string"},
        {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "section": {"const": "packages"},
        "setting": {"const": "sssd_installed"},
        "expected": {"type": "boolean"}
      }
    },
    {
      "properties": {
        "section": {"const": "sssd"},
        "setting": {"const": "domain"},
        "expected": {"type": "string"}
      }
    },
    {
      "properties": {
        "section": {"const": "ssh"},
        "setting": {"const": "allowed_groups"},
        "expected": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    {
      "properties": {
        "section": {"const": "accounts"},
        "setting": {"const": "unmanaged_interactive_accounts"},
        "expected": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  ]
}
