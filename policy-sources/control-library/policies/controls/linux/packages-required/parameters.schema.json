{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/controls/linux.packages.required/parameters/v1.schema.json",
  "type": "object",
  "required": ["ecosystem", "required"],
  "additionalProperties": false,
  "properties": {
    "ecosystem": {"const": "linux-native"},
    "required": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
        }
      }
    }
  }
}
