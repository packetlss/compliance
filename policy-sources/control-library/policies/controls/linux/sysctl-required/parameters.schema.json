{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/controls/linux-sysctl-required-parameters-v1.schema.json",
  "type": "object",
  "required": ["settings"],
  "additionalProperties": false,
  "properties": {
    "settings": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9_-]+(?:\\.[a-zA-Z0-9_-]+)+$"
      },
      "additionalProperties": {"type": "string"}
    }
  }
}
