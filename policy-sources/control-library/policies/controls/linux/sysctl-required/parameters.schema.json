{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/controls/linux-sysctl-required-parameters-v1.schema.json",
  "type": "object",
  "required": ["settings"],
  "additionalProperties": false,
  "properties": {
    "settings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["key", "value"],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+(?:\\.[a-zA-Z0-9_-]+)+$"
          },
          "value": {"type": "string"}
        }
      }
    }
  }
}
