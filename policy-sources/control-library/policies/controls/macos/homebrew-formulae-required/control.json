{
  "apiVersion": "compliance.example/v1",
  "kind": "Control",
  "metadata": {
    "id": "macos.homebrew.formulae_required",
    "version": 1
  },
  "spec": {
    "entrypoint": "data.compliance.controls.macos.homebrew_formulae_required.evaluate",
    "applies_to": ["macos-workstation"],
    "evidence": [
      {
        "type": "macos.homebrew/v1",
        "required": true,
        "max_age": "24h"
      }
    ],
    "parameters_schema": "parameters.schema.json",
    "defaults": {
      "severity": "medium",
      "remediation": "Install missing formulae from the approved Homebrew source."
    }
  }
}
