{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/controls/macos.system.minimum-version/parameters/v1.schema.json",
  "type": "object",
  "required": ["minimum"],
  "additionalProperties": false,
  "properties": {
    "minimum": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
