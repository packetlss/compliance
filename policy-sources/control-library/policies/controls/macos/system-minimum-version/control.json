{
  "apiVersion": "compliance.example/v1",
  "kind": "Control",
  "metadata": {
    "id": "macos.system.minimum_version",
    "version": 1
  },
  "spec": {
    "title": "macOS meets the minimum supported version",
    "purpose": "Verify that macOS is at or above the minimum version mandated by policy.",
    "entrypoint": "data.compliance.controls.macos.system_minimum_version.evaluate",
    "applies_to": [
      "macos-workstation"
    ],
    "evidence": [
      {
        "type": "macos.system/v1",
        "id": "observation"
      }
    ],
    "parameters_schema": "parameters.schema.json",
    "defaults": {
      "severity": "high",
      "remediation": "Upgrade macOS to a supported release."
    }
  }
}
