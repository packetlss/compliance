{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/evidence/organization.risk-assessment/v1.schema.json",
  "type": "object",
  "required": ["schema", "id", "subject", "type", "collected_at", "collector", "payload"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "compliance.example/evidence/v1"},
    "id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object", "required": ["id", "type"], "additionalProperties": true,
      "properties": {"id": {"type": "string", "minLength": 1}, "type": {"const": "entity"}}
    },
    "type": {"const": "organization.risk-assessment/v1"},
    "collected_at": {"type": "string", "format": "date-time"},
    "collector": {
      "type": "object", "required": ["id", "version"], "additionalProperties": true,
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "payload": {
      "type": "object",
      "required": ["programme_id", "assessment_id", "scope_id", "assessor_id", "source_locator", "completion_status"],
      "additionalProperties": false,
      "properties": {
        "programme_id": {"type": "string", "minLength": 1},
        "assessment_id": {"type": "string", "minLength": 1},
        "scope_id": {"type": "string", "minLength": 1},
        "assessor_id": {"type": "string", "minLength": 1},
        "source_locator": {"type": "string", "minLength": 1},
        "completion_status": {"enum": ["completed", "not_completed", "inconclusive"]},
        "completed_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {"if": {"properties": {"completion_status": {"const": "completed"}}}, "then": {"required": ["completed_at"]}},
        {"if": {"properties": {"completion_status": {"enum": ["not_completed", "inconclusive"]}}}, "then": {"not": {"required": ["completed_at"]}}}
      ]
    }
  }
}
