{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/evidence/aws.account.configuration/v1.schema.json",
  "type": "object",
  "required": ["schema", "id", "subject", "type", "collected_at", "collector", "payload"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "compliance.example/evidence/v1"},
    "id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"const": "aws-account"}
      }
    },
    "type": {"const": "aws.account.configuration/v1"},
    "collected_at": {"type": "string", "format": "date-time"},
    "collector": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "payload": {
      "type": "object",
      "required": ["account", "root_user", "cloudtrail"],
      "additionalProperties": true,
      "properties": {
        "account": {
          "type": "object",
          "required": ["id"],
          "additionalProperties": true,
          "properties": {"id": {"type": "string", "pattern": "^[0-9]{12}$"}}
        },
        "root_user": {
          "type": "object",
          "required": ["mfa_enabled"],
          "additionalProperties": true,
          "properties": {"mfa_enabled": {"type": ["boolean", "null"]}}
        },
        "cloudtrail": {
          "type": "object",
          "required": ["multi_region_enabled", "retention_days"],
          "additionalProperties": true,
          "properties": {
            "multi_region_enabled": {"type": ["boolean", "null"]},
            "retention_days": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "security_contact": {
          "type": "object",
          "required": ["configured"],
          "additionalProperties": true,
          "properties": {
            "configured": {"type": ["boolean", "null"]}
          }
        }
      }
    }
  }
}
