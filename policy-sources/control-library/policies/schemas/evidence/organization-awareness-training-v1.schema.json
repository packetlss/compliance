{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/evidence/organization.awareness-training/v1.schema.json",
  "type": "object",
  "required": ["schema", "id", "subject", "type", "collected_at", "collector", "payload"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "compliance.example/evidence/v1"},
    "id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object", "required": ["id", "type"], "additionalProperties": true,
      "properties": {"id": {"type": "string", "minLength": 1}, "type": {"const": "entity"}}
    },
    "type": {"const": "organization.awareness-training/v1"},
    "collected_at": {"type": "string", "format": "date-time"},
    "collector": {
      "type": "object", "required": ["id", "version"], "additionalProperties": true,
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "payload": {
      "type": "object",
      "required": ["programme_id", "report_id", "campaign_id", "as_of", "reporting_source_id", "source_locator", "population", "completion"],
      "additionalProperties": false,
      "properties": {
        "programme_id": {"type": "string", "minLength": 1},
        "report_id": {"type": "string", "minLength": 1},
        "campaign_id": {"type": "string", "minLength": 1},
        "as_of": {"type": "string", "format": "date-time"},
        "reporting_source_id": {"type": "string", "minLength": 1},
        "source_locator": {"type": "string", "minLength": 1},
        "population": {
          "type": "object", "required": ["basis_id", "status"], "additionalProperties": false,
          "properties": {"basis_id": {"type": "string", "minLength": 1}, "status": {"enum": ["established", "not_established"]}, "required_count": {"type": "integer", "minimum": 0}},
          "allOf": [
            {"if": {"properties": {"status": {"const": "established"}}}, "then": {"required": ["required_count"]}},
            {"if": {"properties": {"status": {"const": "not_established"}}}, "then": {"not": {"required": ["required_count"]}}}
          ]
        },
        "completion": {
          "type": "object", "required": ["status"], "additionalProperties": false,
          "properties": {"status": {"enum": ["established", "not_established"]}, "completed_count": {"type": "integer", "minimum": 0}},
          "allOf": [
            {"if": {"properties": {"status": {"const": "established"}}}, "then": {"required": ["completed_count"]}},
            {"if": {"properties": {"status": {"const": "not_established"}}}, "then": {"not": {"required": ["completed_count"]}}}
          ]
        }
      }
    }
  }
}
