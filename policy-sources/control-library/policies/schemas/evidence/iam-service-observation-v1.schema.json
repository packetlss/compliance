{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/evidence/iam-service-observation-v1.schema.json",
  "type": "object",
  "required": [
    "schema",
    "id",
    "subject",
    "type",
    "collected_at",
    "collector",
    "payload",
    "integrity"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "const": "compliance.example/evidence/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "linux-host"
        }
      }
    },
    "type": {
      "const": "iam.service.observation/v1"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "collector": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "payload": {
      "type": "object",
      "required": [
        "consumer",
        "source_assertion"
      ],
      "additionalProperties": false,
      "properties": {
        "consumer": {
          "type": "string",
          "minLength": 1
        },
        "source_assertion": {
          "type": "object",
          "required": [
            "subject_id",
            "asserted_by",
            "source_locator",
            "condition",
            "outcome"
          ],
          "additionalProperties": false,
          "properties": {
            "subject_id": {
              "type": "string",
              "minLength": 1
            },
            "asserted_by": {
              "type": "string",
              "minLength": 1
            },
            "source_locator": {
              "type": "string",
              "minLength": 1
            },
            "condition": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "enum": [
                "positive",
                "negative",
                "inconclusive"
              ]
            }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "digest"
      ],
      "additionalProperties": true,
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
