{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/platform/policy/baseline-overlay/v1.schema.json",
  "title": "Compliance baseline overlay",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "compliance.example/v1"
    },
    "kind": {
      "const": "BaselineOverlay"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "required": [
        "title",
        "extends",
        "operations"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "extends": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/parentPin"
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "parameter_links": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/parameterLink"}
        }
      }
    }
  },
  "$defs": {
    "parameterLink": {
      "type": "object",
      "required": ["id", "source", "destination"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {
          "type": "object",
          "required": ["policy", "digest", "slot", "declaration_digest", "schema_digest"],
          "additionalProperties": false,
          "properties": {
            "policy": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*@[a-z0-9]+(?:[.-][a-z0-9]+)*$(?![\\s\\S])"},
            "digest": {"$ref": "#/$defs/digest"},
            "slot": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$(?![\\s\\S])"},
            "declaration_digest": {"$ref": "#/$defs/digest"},
            "schema_digest": {"$ref": "#/$defs/digest"}
          }
        },
        "destination": {
          "type": "object",
          "required": ["instance_id", "implementation", "kind", "path"],
          "additionalProperties": false,
          "properties": {
            "instance_id": {"$ref": "#/$defs/target"},
            "implementation": {
              "type": "object",
              "required": ["id", "version", "fingerprint"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$(?![\\s\\S])"},
                "version": {"$ref": "#/$defs/revision"},
                "fingerprint": {"$ref": "#/$defs/digest"}
              }
            },
            "kind": {"enum": ["parameters", "evidence_inputs", "freshness"]},
            "dependency": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$(?![\\s\\S])"},
            "path": {"type": "string", "pattern": "^/[^/].*"}
          },
          "allOf": [
            {
              "if": {"properties": {"kind": {"const": "parameters"}}},
              "then": {"not": {"required": ["dependency"]}},
              "else": {"required": ["dependency"]}
            },
            {
              "if": {"properties": {"kind": {"const": "freshness"}}},
              "then": {"properties": {"path": {"const": "/max_age"}}}
            }
          ]
        }
      }
    },
    "revision": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$(?![\\s\\S])"
        }
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$(?![\\s\\S])"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "parentPin": {
      "type": "object",
      "required": [
        "baseline",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*@[a-z0-9]+(?:[.-][a-z0-9]+)*$(?![\\s\\S])"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "externalRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "controlInstance": {
      "type": "object",
      "required": [
        "instance_id",
        "implementation"
      ],
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$(?![\\s\\S])"
        },
        "implementation": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$(?![\\s\\S])"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "remediation": {
          "type": "string"
        },
        "external_refs": {
          "$ref": "#/$defs/externalRefs"
        },
        "evidence": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_age": {
                "type": "string",
                "pattern": "^[1-9][0-9]*[smhd]$"
              },
              "inputs": {
                "type": "object"
              }
            },
            "required": []
          }
        }
      }
    },
    "deviation": {
      "type": "object",
      "required": [
        "id",
        "classification",
        "rationale",
        "approval_ref",
        "review_after"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "approval_ref": {
          "type": "string",
          "minLength": 1
        },
        "review_after": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$(?![\\s\\S])"
    },
    "tailorOperation": {
      "type": "object",
      "required": [
        "op",
        "target",
        "expected_parent_fingerprint",
        "parameters",
        "deviation"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "tailor"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "expected_parent_fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "deviation": {
          "$ref": "#/$defs/deviation"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_age": {
                "type": "string",
                "pattern": "^[1-9][0-9]*[smhd]$"
              },
              "inputs": {
                "type": "object"
              }
            },
            "required": []
          }
        }
      }
    },
    "excludeOperation": {
      "type": "object",
      "required": [
        "op",
        "target",
        "expected_parent_fingerprint",
        "deviation"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "exclude"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "expected_parent_fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "deviation": {
          "$ref": "#/$defs/deviation"
        }
      }
    },
    "substituteOperation": {
      "type": "object",
      "required": [
        "op",
        "target",
        "expected_parent_fingerprint",
        "implementation",
        "equivalence_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "substitute"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "expected_parent_fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "implementation": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$(?![\\s\\S])"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "equivalence_ref": {
          "type": "string",
          "minLength": 1
        },
        "parameter_links": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/parameterLink"}
        },
        "evidence": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_age": {
                "type": "string",
                "pattern": "^[1-9][0-9]*[smhd]$"
              },
              "inputs": {
                "type": "object"
              }
            },
            "required": []
          }
        }
      }
    },
    "annotateOperation": {
      "type": "object",
      "required": [
        "op",
        "target",
        "expected_parent_fingerprint",
        "annotations"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "annotate"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "expected_parent_fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "annotations": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "severity": {
              "$ref": "#/$defs/severity"
            },
            "remediation": {
              "type": "string"
            },
            "external_refs": {
              "$ref": "#/$defs/externalRefs"
            }
          }
        }
      }
    },
    "addOperation": {
      "type": "object",
      "required": [
        "op",
        "control"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "add"
        },
        "control": {
          "$ref": "#/$defs/controlInstance"
        }
      }
    },
    "operation": {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "tailor",
            "exclude",
            "substitute",
            "annotate",
            "add"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "tailor"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "$ref": "#/$defs/tailorOperation"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "exclude"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "$ref": "#/$defs/excludeOperation"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "substitute"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "$ref": "#/$defs/substituteOperation"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "annotate"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "$ref": "#/$defs/annotateOperation"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "add"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "$ref": "#/$defs/addOperation"
          }
        }
      ]
    }
  }
}
