{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/platform/policy/baseline/v1.schema.json",
  "title": "Compliance baseline",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "compliance.example/v1"
    },
    "kind": {
      "const": "Baseline"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "required": [
        "title",
        "controls"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/controlInstance"
          }
        },
        "parameter_links": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/parameterLink"}
        }
      }
    }
  },
  "$defs": {
    "parameterLink": {
      "type": "object",
      "required": ["id", "source", "destination"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {
          "type": "object",
          "required": ["policy", "digest", "slot", "declaration_digest", "schema_digest"],
          "additionalProperties": false,
          "properties": {
            "policy": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*@[a-z0-9]+(?:[.-][a-z0-9]+)*$(?![\\s\\S])"},
            "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "slot": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$(?![\\s\\S])"},
            "declaration_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "schema_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        "destination": {
          "type": "object",
          "required": ["instance_id", "implementation", "kind", "path"],
          "additionalProperties": false,
          "properties": {
            "instance_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$(?![\\s\\S])"},
            "implementation": {
              "type": "object",
              "required": ["id", "version", "fingerprint"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$(?![\\s\\S])"},
                "version": {"$ref": "#/$defs/revision"},
                "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              }
            },
            "kind": {"enum": ["parameters", "evidence_inputs", "freshness"]},
            "dependency": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$(?![\\s\\S])"},
            "path": {"type": "string", "pattern": "^/[^/].*"}
          },
          "allOf": [
            {
              "if": {"properties": {"kind": {"const": "parameters"}}},
              "then": {"not": {"required": ["dependency"]}},
              "else": {"required": ["dependency"]}
            },
            {
              "if": {"properties": {"kind": {"const": "freshness"}}},
              "then": {"properties": {"path": {"const": "/max_age"}}}
            }
          ]
        }
      }
    },
    "revision": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$(?![\\s\\S])"
        }
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$(?![\\s\\S])"
        },
        "version": {
          "$ref": "#/$defs/revision"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "origin": {
          "type": "object",
          "required": [
            "type",
            "name"
          ],
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "version"
          ],
          "not": {
            "required": [
              "revision"
            ]
          }
        },
        {
          "required": [
            "revision"
          ],
          "not": {
            "required": [
              "version"
            ]
          }
        }
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "externalRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "controlInstance": {
      "type": "object",
      "required": [
        "instance_id",
        "implementation"
      ],
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$(?![\\s\\S])"
        },
        "implementation": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$(?![\\s\\S])"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "remediation": {
          "type": "string"
        },
        "external_refs": {
          "$ref": "#/$defs/externalRefs"
        },
        "evidence": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_age": {
                "type": "string",
                "pattern": "^[1-9][0-9]*[smhd]$"
              },
              "inputs": {
                "type": "object"
              }
            },
            "required": []
          }
        }
      }
    }
  }
}
