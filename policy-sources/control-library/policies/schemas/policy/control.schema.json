{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/platform/policy/control/v1.schema.json",
  "title": "Compliance control implementation manifest",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "compliance.example/v1"
    },
    "kind": {
      "const": "Control"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$"
        },
        "version": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
            }
          ]
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "title",
        "purpose",
        "entrypoint",
        "applies_to",
        "evidence",
        "parameters_schema"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "purpose": {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^data(\\.[a-zA-Z_][a-zA-Z0-9_]*)+$"
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceRequirement"
          }
        },
        "parameters_schema": {
          "type": "string",
          "minLength": 1
        },
        "defaults": {
          "$ref": "#/$defs/defaults"
        }
      }
    }
  },
  "$defs": {
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "evidenceRequirement": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*/v[1-9][0-9]*$"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "inputs_schema": {
          "type": "object"
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "remediation": {
          "type": "string"
        }
      }
    }
  }
}
