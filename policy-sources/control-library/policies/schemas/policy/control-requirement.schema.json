{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/platform/policy/control-requirement/v1alpha1.schema.json",
  "title": "Technology-neutral compliance control requirement",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "compliance.example/v1alpha1"
    },
    "kind": {
      "const": "ControlRequirement"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "origin": {
          "type": "object",
          "required": [
            "type",
            "name"
          ],
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "title",
        "statement"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "external_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "required": {
                "type": "boolean"
              },
              "binding_mode": {
                "enum": [
                  "open",
                  "fixed"
                ]
              },
              "schema": {
                "type": "object"
              },
              "schema_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "composition": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "additive-set"
                  }
                }
              },
              "binding_scope": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$"
                }
              },
              "value": {},
              "representation": {
                "const": "duration"
              }
            },
            "required": [
              "required",
              "binding_mode",
              "schema",
              "schema_digest"
            ],
            "oneOf": [
              {
                "properties": {
                  "binding_mode": {
                    "const": "fixed"
                  }
                },
                "required": [
                  "value"
                ],
                "not": {
                  "required": [
                    "binding_scope"
                  ]
                }
              },
              {
                "properties": {
                  "binding_mode": {
                    "const": "open"
                  }
                },
                "required": [
                  "binding_scope"
                ],
                "not": {
                  "required": [
                    "value"
                  ]
                }
              }
            ],
            "allOf": [
              {
                "if": {
                  "required": [
                    "composition"
                  ]
                },
                "then": {
                  "not": {
                    "required": [
                      "representation"
                    ]
                  },
                  "properties": {
                    "schema": {
                      "required": [
                        "type",
                        "items"
                      ],
                      "properties": {
                        "type": {
                          "const": "array"
                        },
                        "items": {
                          "type": "object",
                          "required": [
                            "type"
                          ],
                          "properties": {
                            "type": {
                              "const": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$"
    },
    "revision": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        }
      ]
    }
  }
}
