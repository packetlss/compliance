{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/platform/policy/requirement-baseline/v1alpha1.schema.json",
  "title": "Compliance requirement baseline",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": "compliance.example/v1alpha1"},
    "kind": {"const": "RequirementBaseline"},
    "metadata": {
      "type": "object",
      "required": ["id", "revision"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "revision": {"$ref": "#/$defs/revision"},
        "origin": {"type": "object", "additionalProperties": true}
      }
    },
    "spec": {
      "type": "object",
      "required": ["title", "requirements"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "pattern": ".*\\S.*"},
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/requirementPin"}
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$(?![\\s\\S])"
    },
    "revision": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$(?![\\s\\S])"}
      ]
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requirementPin": {
      "type": "object",
      "required": ["requirement", "digest"],
      "additionalProperties": false,
      "properties": {
        "requirement": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*@[a-z0-9]+(?:[.-][a-z0-9]+)*$(?![\\s\\S])"
        },
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
