{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/platform/policy/control-realization/v1alpha1.schema.json",
  "title": "Environment-specific realization of a control requirement",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "compliance.example/v1alpha1"
    },
    "kind": {
      "const": "ControlRealization"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "requirement",
        "applies_to",
        "adoption"
      ],
      "additionalProperties": false,
      "properties": {
        "requirement": {
          "$ref": "#/$defs/requirementPin"
        },
        "based_on": {
          "$ref": "#/$defs/realizationPin"
        },
        "applies_to": {
          "type": "object",
          "required": [
            "subject_types"
          ],
          "additionalProperties": false,
          "properties": {
            "subject_types": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "match_labels": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "adoption": {
          "$ref": "#/$defs/adoption"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/controlInstance"
          }
        },
        "parameter_links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "requirement": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*@[a-z0-9]+(?:[.-][a-z0-9]+)*$(?![\\s\\S])"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "slot": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$(?![\\s\\S])"
                  },
                  "declaration_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "schema_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "requirement",
                  "digest",
                  "slot",
                  "declaration_digest",
                  "schema_digest"
                ]
              },
              "destination": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "instance_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$(?![\\s\\S])"
                  },
                  "implementation": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$(?![\\s\\S])"
                      },
                      "version": {
                        "oneOf": [
                          {
                            "type": "integer",
                            "minimum": 1
                          },
                          {
                            "type": "string",
                            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$(?![\\s\\S])"
                          }
                        ]
                      },
                      "fingerprint": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "id",
                      "version",
                      "fingerprint"
                    ]
                  },
                  "kind": {
                    "enum": [
                      "parameters",
                      "evidence_inputs",
                      "freshness"
                    ]
                  },
                  "dependency": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$(?![\\s\\S])"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^/[^/].*"
                  }
                },
                "required": [
                  "instance_id",
                  "implementation",
                  "kind",
                  "path"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "parameters"
                        }
                      }
                    },
                    "then": {
                      "not": {
                        "required": [
                          "dependency"
                        ]
                      }
                    },
                    "else": {
                      "required": [
                        "dependency"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "freshness"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "path": {
                          "const": "/max_age"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "id",
              "source",
              "destination"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "adoption": {
                "properties": {
                  "status": {
                    "const": "implemented"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          },
          "then": {
            "required": [
              "checks"
            ],
            "properties": {
              "checks": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "checks": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$(?![\\s\\S])"
    },
    "revision": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$(?![\\s\\S])"
        }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "requirementPin": {
      "type": "object",
      "required": [
        "requirement",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "requirement": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*@[a-z0-9]+(?:[.-][a-z0-9]+)*$(?![\\s\\S])"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "realizationPin": {
      "type": "object",
      "required": [
        "realization",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "realization": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*@[a-z0-9]+(?:[.-][a-z0-9]+)*$(?![\\s\\S])"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "adoption": {
      "type": "object",
      "required": [
        "status",
        "method",
        "owner"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "implemented",
            "not_implemented",
            "not_applicable"
          ]
        },
        "method": {
          "type": "string",
          "enum": [
            "automated",
            "hybrid",
            "manual",
            "none"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "implementation_ref": {
          "type": "string",
          "minLength": 1
        },
        "determination": {
          "type": "object",
          "required": [
            "rationale",
            "approval_ref",
            "review_after"
          ],
          "additionalProperties": false,
          "properties": {
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "approval_ref": {
              "type": "string",
              "minLength": 1
            },
            "review_after": {
              "type": "string",
              "format": "date"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "implemented"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "implementation_ref"
            ],
            "properties": {
              "method": {
                "enum": [
                  "automated",
                  "hybrid",
                  "manual"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "determination"
            ],
            "properties": {
              "method": {
                "const": "none"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_implemented"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "method": {
                "const": "none"
              }
            }
          }
        }
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "controlInstance": {
      "type": "object",
      "required": [
        "instance_id",
        "implementation"
      ],
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "$ref": "#/$defs/identifier"
        },
        "implementation": {
          "$ref": "#/$defs/identifier"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "remediation": {
          "type": "string"
        },
        "evidence": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_age": {
                "type": "string",
                "pattern": "^[1-9][0-9]*[smhd]$"
              },
              "inputs": {
                "type": "object"
              }
            },
            "required": []
          }
        }
      }
    }
  }
}
