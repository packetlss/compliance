{
  "apiVersion": "compliance.example/v1alpha1",
  "kind": "ParameterPolicy",
  "metadata": {
    "id": "company.database-software",
    "revision": 1
  },
  "spec": {
    "parameter_contributions": [
      {
        "id": "database-packages",
        "target": {
          "policy": "company.authorized-software",
          "slot": "allowed_software"
        },
        "members": [
          "postgresql"
        ]
      }
    ]
  }
}
