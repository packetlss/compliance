{
  "apiVersion": "compliance.example/v1alpha1",
  "kind": "ControlRealization",
  "metadata": {
    "id": "company.linux.administrative-access-identity-gated",
    "revision": 1
  },
  "spec": {
    "requirement": {
      "requirement": "company.administrative-access.identity-gated@1",
      "digest": "sha256:c7aab5b7f10e6df44c7bc48cfd5c2ae9cb3d3c29bb7bb209d36963afc4da8b04"
    },
    "applies_to": {
      "subject_types": [
        "linux-host"
      ]
    },
    "adoption": {
      "status": "implemented",
      "method": "automated",
      "owner": "synthetic-linux-platform-team",
      "implementation_ref": "synthetic/linux-administrative-access-v1"
    },
    "checks": [
      {
        "instance_id": "company.linux.administrative-access.iam-domain-configured",
        "implementation": "linux.access.setting-equals",
        "severity": "critical",
        "remediation": "Connect the host to the approved company IAM domain.",
        "parameters": {
          "section": "sssd",
          "setting": "domain",
          "expected": "company.example"
        },
        "evidence": {
          "observation": {
            "max_age": "24h"
          }
        }
      },
      {
        "instance_id": "company.linux.administrative-access.operator-group-required",
        "implementation": "linux.access.setting-equals",
        "severity": "critical",
        "remediation": "Restrict interactive SSH access to the approved company operator group.",
        "parameters": {
          "section": "ssh",
          "setting": "allowed_groups",
          "expected": [
            "company-linux-operators"
          ]
        },
        "evidence": {
          "observation": {
            "max_age": "24h"
          }
        }
      },
      {
        "instance_id": "company.linux.administrative-access.unmanaged-local-accounts-absent",
        "implementation": "linux.access.setting-equals",
        "severity": "critical",
        "remediation": "Remove interactive authorization from unmanaged local accounts.",
        "parameters": {
          "section": "accounts",
          "setting": "unmanaged_interactive_accounts",
          "expected": []
        },
        "evidence": {
          "observation": {
            "max_age": "24h"
          }
        }
      }
    ],
    "satisfaction": {
      "allOf": [
        "company.linux.administrative-access.iam-domain-configured",
        "company.linux.administrative-access.operator-group-required",
        "company.linux.administrative-access.unmanaged-local-accounts-absent"
      ]
    }
  }
}
