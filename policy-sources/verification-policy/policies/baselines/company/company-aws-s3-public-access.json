{
  "apiVersion": "compliance.example/v1",
  "kind": "Baseline",
  "metadata": {
    "id": "company.aws-s3-public-access",
    "revision": 1
  },
  "spec": {
    "title": "Company Amazon S3 public-access policy",
    "controls": [
      {
        "instance_id": "company.aws.s3-account-public-access-block",
        "implementation": "aws.s3.account_public_access_block_required",
        "external_refs": [
          "AWS-Security-Hub:S3.1"
        ],
        "severity": "high",
        "remediation": "Enable all four Amazon S3 account-level Block Public Access settings through the approved cloud configuration workflow.",
        "parameters": {
          "block_public_acls": true,
          "block_public_policy": true,
          "ignore_public_acls": true,
          "restrict_public_buckets": true
        },
        "evidence": {
          "observation": {
            "max_age": "24h"
          }
        }
      }
    ]
  }
}
