{
  "apiVersion": "compliance.example/v1",
  "kind": "BaselineOverlay",
  "metadata": {
    "id": "company.macos-policy",
    "revision": 1
  },
  "spec": {
    "extends": [
      {
        "baseline": "benchmark.example.macos-hardening@2026.1",
        "digest": "sha256:720bed5dfc2c2d22b884ff36b77fa19e31cd948d41968615ccaa2953b5c9050f"
      }
    ],
    "operations": [
      {
        "op": "tailor",
        "target": "benchmark.example.macos.minimum-version",
        "expected_parent_fingerprint": "sha256:7c793db86ac6eb5ac69475d50a2d3d3ad4c6f8f556059db2ab5e6e2e36c21f6f",
        "parameters": {
          "minimum": "26.0.0"
        },
        "deviation": {
          "id": "DEV-MAC-001",
          "classification": "support-policy",
          "rationale": "Company policy supports the current major macOS release rather than requiring the benchmark example's later point release.",
          "approval_ref": "company-policy/macos-support-lifecycle",
          "review_after": "2027-01-31"
        }
      },
      {
        "op": "exclude",
        "target": "benchmark.example.macos.audit-formula-required",
        "expected_parent_fingerprint": "sha256:88103cfc471430fb952f1d1049a64ea4908b15a7615b80993243bb6a528397a5",
        "deviation": {
          "id": "DEV-MAC-002",
          "classification": "alternative-company-control",
          "rationale": "The illustrative benchmark audit formula is not part of the approved company workstation tooling.",
          "approval_ref": "company-policy/endpoint-monitoring",
          "review_after": "2027-01-31"
        }
      },
      {
        "op": "seal",
        "target": "benchmark.example.macos.gatekeeper-enabled",
        "expected_parent_fingerprint": "sha256:2e28771b3f6d2bd2f3b787d725193e87523e73d121ca28d2c9459fe106f1b7d0",
        "blocked_operations": [
          "tailor",
          "exclude",
          "substitute"
        ],
        "reason": "Use-case overlays may not weaken the company Gatekeeper requirement."
      },
      {
        "op": "add",
        "control": {
          "instance_id": "company.macos.opa-required",
          "implementation": "macos.homebrew.formulae_required",
          "parameters": {
            "required": [
              "opa"
            ]
          },
          "evidence": {
            "observation": {
              "max_age": "24h"
            }
          }
        }
      }
    ]
  }
}
