{
  "apiVersion": "compliance.example/v1",
  "kind": "BaselineOverlay",
  "metadata": {
    "id": "company.aws-foundation",
    "revision": 1
  },
  "spec": {
    "title": "Company AWS foundation policy",
    "extends": [
      {
        "baseline": "profile.csa-ccm.aws-foundations@4.1-profile1",
        "digest": "sha256:6f0661efbaa08d41e28a87669218018dfc5be282abe7f2eee7654c5a350cc811"
      }
    ],
    "operations": [
      {
        "op": "tailor",
        "target": "csa-ccm.aws.audit-log-retention",
        "expected_parent_fingerprint": "sha256:702d6620cd1d1a3ddb92559619c826d95196325ac362ebfb8b441c19ba249f4c",
        "parameters": {
          "section": "cloudtrail",
          "setting": "retention_days",
          "minimum": 90
        },
        "deviation": {
          "id": "DEV-AWS-001",
          "classification": "centralized-retention-architecture",
          "rationale": "The account keeps 90 days searchable locally while the central immutable archive retains audit data for at least 365 days.",
          "approval_ref": "company-policy/cloud-audit-retention",
          "review_after": "2027-08-23"
        }
      },
      {
        "op": "annotate",
        "target": "csa-ccm.aws.multi-region-audit-trail",
        "expected_parent_fingerprint": "sha256:69fc866d51684628f45cf68fb2e1976f61e773982928c3fd27322b24e5f42539",
        "annotations": {
          "severity": "critical",
          "remediation": "Enable the organization CloudTrail for all enabled Regions through the approved landing-zone deployment."
        }
      },
      {
        "op": "add",
        "control": {
          "instance_id": "company.aws.security-contact-configured",
          "implementation": "aws.account.setting_equals",
          "severity": "medium",
          "remediation": "Configure the AWS account SECURITY alternate contact using the approved security operations address.",
          "parameters": {
            "section": "security_contact",
            "setting": "configured",
            "expected": true
          },
          "evidence": {
            "observation": {
              "max_age": "24h"
            }
          }
        }
      }
    ]
  }
}
