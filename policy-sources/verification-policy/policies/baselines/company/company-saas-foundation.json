{
  "apiVersion": "compliance.example/v1",
  "kind": "BaselineOverlay",
  "metadata": {
    "id": "company.saas-foundation",
    "revision": 1
  },
  "spec": {
    "title": "Company SaaS foundation policy",
    "extends": [
      {
        "baseline": "profile.csa-ccm.saas-foundations@4.1-profile1",
        "digest": "sha256:9cc4e2982063166dd1e65a8ff82477b2d817845ab71fe32f9be729a700a0a226"
      }
    ],
    "operations": [
      {
        "op": "tailor",
        "target": "csa-ccm.saas.audit-log-retention",
        "expected_parent_fingerprint": "sha256:9f1b0aea49bc2f5a93996ae0aa92f31e3855c86761ea52f313c2605dfd8bdde7",
        "parameters": {
          "section": "audit_log",
          "setting": "retention_days",
          "minimum": 180
        },
        "deviation": {
          "id": "DEV-SAAS-001",
          "classification": "vendor-capability",
          "rationale": "The contracted SaaS tier retains 180 days in-product; longer retention is handled by the company's external audit export.",
          "approval_ref": "risk-register/SAAS-AUDIT-RETENTION",
          "review_after": "2027-08-23"
        }
      },
      {
        "op": "annotate",
        "target": "csa-ccm.saas.mfa-enforced",
        "expected_parent_fingerprint": "sha256:07856d1e798aa9fb52b07bcd763a00bcc376cc9ff39291450dab770a5998afc4",
        "annotations": {
          "severity": "critical",
          "remediation": "Enforce MFA for every interactive tenant account, including accounts outside the company SSO domain."
        }
      },
      {
        "op": "add",
        "control": {
          "instance_id": "company.saas.guest-access-disabled",
          "implementation": "saas.tenant.setting-equals",
          "severity": "high",
          "remediation": "Disable guest access in the tenant security administration page.",
          "parameters": {
            "section": "guest_access",
            "setting": "allowed",
            "expected": false
          },
          "evidence": {
            "observation": {
              "max_age": "24h"
            }
          }
        }
      }
    ]
  }
}
