{
  "apiVersion": "compliance.example/v1",
  "kind": "BaselineOverlay",
  "metadata": {
    "id": "company.container-runtime-host",
    "revision": 1
  },
  "spec": {
    "title": "Company container-runtime host policy",
    "extends": [
      {
        "baseline": "company.linux-server-hardening@1",
        "digest": "sha256:57bd91cecc2b6266b3676be8fa9b205f08bc904d6d7164dc18e9d85f967fab29"
      }
    ],
    "operations": [
      {
        "op": "tailor",
        "target": "benchmark.example.linux-server.ip-forwarding-disabled",
        "expected_parent_fingerprint": "sha256:915a4af338d0397029462fbca2069aeb4166615dc65301460502447ff43d8591",
        "parameters": {
          "settings": {
            "net.ipv4.ip_forward": "1"
          }
        },
        "deviation": {
          "id": "DEV-LINUX-CONTAINER-001",
          "classification": "required-platform-feature",
          "rationale": "Approved container runtime hosts require IPv4 forwarding for workload networking.",
          "approval_ref": "company-policy/container-runtime-host-networking",
          "review_after": "2027-08-31"
        }
      },
      {
        "op": "add",
        "control": {
          "instance_id": "company.container-runtime.containerd-package",
          "implementation": "linux.packages.required",
          "parameters": {
            "ecosystem": "linux-native",
            "required": [
              {
                "id": "containerd"
              }
            ]
          },
          "evidence": {
            "observation": {
              "max_age": "24h"
            }
          }
        }
      }
    ]
  }
}
