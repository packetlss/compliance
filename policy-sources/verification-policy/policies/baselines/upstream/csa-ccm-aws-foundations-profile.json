{
  "apiVersion": "compliance.example/v1",
  "kind": "Baseline",
  "metadata": {
    "id": "profile.csa-ccm.aws-foundations",
    "revision": "4.1-profile1",
    "origin": {
      "type": "framework-derived-profile",
      "name": "Illustrative AWS automation profile mapped to CSA CCM v4.1",
      "source": "https://cloudsecurityalliance.org/artifacts/cloud-controls-matrix-v4-1",
      "notice": "This small technical profile is not the CSA CCM catalog and does not assert certification or full framework coverage."
    }
  },
  "spec": {
    "title": "Illustrative CSA CCM AWS foundations profile",
    "controls": [
      {
        "instance_id": "csa-ccm.aws.root-mfa-enabled",
        "implementation": "aws.account.setting_equals",
        "external_refs": [
          "CSA-CCM-v4.1:IAM-domain"
        ],
        "parameters": {
          "section": "root_user",
          "setting": "mfa_enabled",
          "expected": true
        },
        "evidence": {
          "observation": {
            "max_age": "24h"
          }
        }
      },
      {
        "instance_id": "csa-ccm.aws.multi-region-audit-trail",
        "implementation": "aws.account.setting_equals",
        "external_refs": [
          "CSA-CCM-v4.1:LOG-03"
        ],
        "parameters": {
          "section": "cloudtrail",
          "setting": "multi_region_enabled",
          "expected": true
        },
        "evidence": {
          "observation": {
            "max_age": "24h"
          }
        }
      },
      {
        "instance_id": "csa-ccm.aws.audit-log-retention",
        "implementation": "aws.account.number_at_least",
        "external_refs": [
          "CSA-CCM-v4.1:LOG-domain"
        ],
        "parameters": {
          "section": "cloudtrail",
          "setting": "retention_days",
          "minimum": 365
        },
        "evidence": {
          "observation": {
            "max_age": "24h"
          }
        }
      }
    ]
  }
}
