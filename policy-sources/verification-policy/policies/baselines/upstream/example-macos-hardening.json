{
  "apiVersion": "compliance.example/v1",
  "kind": "Baseline",
  "metadata": {
    "id": "benchmark.example.macos-hardening",
    "revision": "2026.1",
    "origin": {
      "type": "external-benchmark",
      "name": "Illustrative macOS Hardening Benchmark"
    }
  },
  "spec": {
    "title": "Illustrative macOS hardening benchmark",
    "controls": [
      {
        "instance_id": "benchmark.example.macos.minimum-version",
        "implementation": "macos.system.minimum-version",
        "external_refs": [
          "illustrative-benchmark:1.1"
        ],
        "parameters": {
          "minimum": "26.6.0"
        },
        "evidence": {
          "observation": {
            "max_age": "24h"
          }
        }
      },
      {
        "instance_id": "benchmark.example.macos.gatekeeper-enabled",
        "implementation": "macos.security.setting-equals",
        "external_refs": [
          "illustrative-benchmark:1.2"
        ],
        "parameters": {
          "setting": "gatekeeper",
          "expected": "enabled"
        },
        "evidence": {
          "observation": {
            "max_age": "24h"
          }
        }
      },
      {
        "instance_id": "benchmark.example.macos.audit-formula-required",
        "implementation": "macos.homebrew.formulae-required",
        "external_refs": [
          "illustrative-benchmark:1.3"
        ],
        "parameters": {
          "required": [
            "example-audit-tool"
          ]
        },
        "evidence": {
          "observation": {
            "max_age": "24h"
          }
        }
      }
    ]
  }
}
