{
  "apiVersion": "compliance.example/v1",
  "kind": "Baseline",
  "metadata": {
    "id": "benchmark.example.linux-server-hardening",
    "revision": "2026.1",
    "origin": {
      "type": "external-benchmark",
      "name": "Illustrative Linux Server Hardening Benchmark"
    }
  },
  "spec": {
    "title": "Illustrative Linux server hardening benchmark",
    "controls": [
      {
        "instance_id": "benchmark.example.linux-server.aslr",
        "implementation": "linux.sysctl.required",
        "external_refs": [
          "illustrative-linux-benchmark:1.1"
        ],
        "parameters": {
          "settings": {
            "kernel.randomize_va_space": "2"
          }
        },
        "evidence": {
          "observation": {
            "max_age": "24h"
          }
        }
      },
      {
        "instance_id": "benchmark.example.linux-server.ip-forwarding-disabled",
        "implementation": "linux.sysctl.required",
        "external_refs": [
          "illustrative-linux-benchmark:1.2"
        ],
        "parameters": {
          "settings": {
            "net.ipv4.ip_forward": "0"
          }
        },
        "evidence": {
          "observation": {
            "max_age": "24h"
          }
        }
      }
    ]
  }
}
