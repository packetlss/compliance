{
  "apiVersion": "compliance.example/v1",
  "kind": "Baseline",
  "metadata": {
    "id": "managed-workstation",
    "version": 1
  },
  "spec": {
    "title": "Managed workstation policy",
    "controls": [
      {
        "instance_id": "workstation.homebrew.required-formulae",
        "implementation": "macos.homebrew.formulae-required",
        "parameters": {
          "required": [
            "git"
          ]
        },
        "evidence": {
          "observation": {
            "max_age": "24h"
          }
        }
      },
      {
        "instance_id": "workstation.macos.sip-enabled",
        "implementation": "macos.security.setting-equals",
        "parameters": {
          "setting": "sip",
          "expected": "enabled"
        },
        "evidence": {
          "observation": {
            "max_age": "24h"
          }
        }
      }
    ]
  }
}
