{
  "apiVersion": "compliance.example/v1",
  "kind": "Baseline",
  "metadata": {
    "id": "managed-workstation",
    "version": 1
  },
  "spec": {
    "controls": [
      {
        "instance_id": "workstation.homebrew.required-formulae",
        "implementation": "macos.homebrew.formulae_required",
        "parameters": {
          "required": ["git"]
        }
      },
      {
        "instance_id": "workstation.macos.sip-enabled",
        "implementation": "macos.security.setting_equals",
        "parameters": {
          "setting": "sip",
          "expected": "enabled"
        }
      }
    ]
  }
}
