    },
    "requirement": {
      "requirement": "company.iam.role-based-access@1",
      "digest": "sha256:ba6b5a6c53d1d5b53f4d55fdac510989b8e8bd0ff354d7956160f430d0a5b4b7"
    },
    "applies_to": {
      "subject_types": [
        "linux-host"
      ],
      "match_labels": {
        "iam-profile": "restricted-linux"
      }
    },
    "adoption": {
      "status": "implemented",
      "method": "automated",
      "owner": "restricted-environment-iam-team",
      "implementation_ref": "restricted-architecture/linux-central-access-v3"
    },
    "checks": [
      {
        "instance_id": "restricted.linux.rbac.sssd-installed",
        "implementation": "linux.access.setting-equals",
        "severity": "high",
        "remediation": "Install SSSD using the environment-approved package source.",
        "parameters": {
          "section": "packages",
          "setting": "sssd_installed",
          "expected": true
        }
      },
      {
        "instance_id": "restricted.linux.rbac.sssd-domain-configured",
        "implementation": "linux.access.setting-equals",
        "severity": "critical",
        "remediation": "Connect SSSD to the approved central IAM domain using the restricted environment procedure.",
        "parameters": {
          "section": "sssd",
          "setting": "domain",
          "expected": "restricted.example"
        }
      },
      {
        "instance_id": "restricted.linux.rbac.ssh-central-group-required",
        "implementation": "linux.access.setting-equals",
        "severity": "critical",
        "remediation": "Restrict interactive SSH access to the approved central IAM group.",
        "parameters": {
          "section": "ssh",
          "setting": "allowed_groups",
          "expected": [
            "linux-production-operators"
          ]
        }
      },
      {
        "instance_id": "restricted.linux.rbac.unmanaged-local-login-absent",
        "implementation": "linux.access.setting-equals",
        "severity": "critical",
        "remediation": "Remove interactive authorization from unmanaged local accounts or enroll the identity in central IAM.",
        "parameters": {
          "section": "accounts",
          "setting": "unmanaged_interactive_accounts",
          "expected": []
        }
      }
    ],
