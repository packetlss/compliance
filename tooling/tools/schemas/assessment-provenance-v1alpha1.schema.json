                  "required": [
                    "digest",
                    "digestAlgorithm"
                  ],
                  "properties": {
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "digestAlgorithm": {
                      "const": "compliance.example/tooling-source-tree-digest/v1alpha1"
                    }
                  }
                },
                "execution": {
