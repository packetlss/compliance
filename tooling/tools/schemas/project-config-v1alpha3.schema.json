{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/platform/project-config/v1alpha3.schema.json",
  "title": "Compliance project configuration with actual composition and optional enforcement",
  "type": "object",
  "required": [
    "schema",
    "policySources",
    "paths"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "compliance.example/project-config/v1alpha3"
    },
    "policySources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/policySource"
      }
    },
    "paths": {
      "type": "object",
      "required": [
        "inventory",
        "assignments",
        "evidence",
        "plan",
        "results",
        "waivers"
      ],
      "additionalProperties": false,
      "properties": {
        "inventory": {
          "$ref": "#/$defs/path"
        },
        "assignments": {
          "$ref": "#/$defs/path"
        },
        "evidence": {
          "$ref": "#/$defs/path"
        },
        "plan": {
          "$ref": "#/$defs/path"
        },
        "results": {
          "$ref": "#/$defs/path"
        },
        "waivers": {
          "$ref": "#/$defs/path"
        },
        "frameworkDeclarations": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "expectedComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "const": "compliance.lock.yaml"
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policySource": {
      "type": "object",
      "required": [
        "name",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "expectedContent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "digest",
            "digestAlgorithm"
          ],
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "digestAlgorithm": {
              "const": "compliance.example/policy-source-tree-digest/v1alpha1"
            }
          }
        }
      }
    }
  }
}
