{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/config/project-config-v1alpha2.schema.json",
  "title": "Compliance locked project configuration",
  "type": "object",
  "required": ["schema", "policySources", "paths"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "compliance.example/project-config/v1alpha2"
    },
    "policySources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/policySource"
      }
    },
    "paths": {
      "type": "object",
      "required": [
        "inventory",
        "assignments",
        "evidence",
        "plan",
        "results",
        "waivers"
      ],
      "additionalProperties": false,
      "properties": {
        "inventory": {"$ref": "#/$defs/path"},
        "assignments": {"$ref": "#/$defs/path"},
        "evidence": {"$ref": "#/$defs/path"},
        "plan": {"$ref": "#/$defs/path"},
        "results": {"$ref": "#/$defs/path"},
        "waivers": {"$ref": "#/$defs/path"}
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policySource": {
      "type": "object",
      "required": ["name", "path", "digest"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
        },
        "path": {"$ref": "#/$defs/path"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
