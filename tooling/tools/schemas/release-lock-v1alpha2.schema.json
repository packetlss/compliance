{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/releases/release-lock-v1alpha2.schema.json",
  "title": "Compliance content-addressed release lock",
  "type": "object",
  "required": ["schema", "tooling", "policySources"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "compliance.example/release-lock/v1alpha2"},
    "tooling": {
      "type": "object",
      "required": ["distribution", "version", "source", "artifact"],
      "additionalProperties": false,
      "properties": {
        "distribution": {"const": "compliance-tooling"},
        "version": {"$ref": "#/$defs/semver"},
        "source": {
          "type": "object",
          "required": ["digest", "digestAlgorithm"],
          "additionalProperties": false,
          "properties": {
            "digest": {"$ref": "#/$defs/digest"},
            "digestAlgorithm": {
              "const": "compliance.example/tooling-source-tree-digest/v1alpha1"
            }
          }
        },
        "artifact": {
          "type": "object",
          "required": ["kind", "sha256"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "python-wheel"},
            "sha256": {"$ref": "#/$defs/digest"}
          }
        }
      }
    },
    "policySources": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["distribution", "version", "content"],
        "additionalProperties": false,
        "properties": {
          "distribution": {"type": "string", "minLength": 1},
          "version": {"$ref": "#/$defs/semver"},
          "content": {
            "type": "object",
            "required": ["digest", "digestAlgorithm"],
            "additionalProperties": false,
            "properties": {
              "digest": {"$ref": "#/$defs/digest"},
              "digestAlgorithm": {
                "const": "compliance.example/policy-source-tree-digest/v1alpha1"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    }
  }
}
