{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/assessment-plan-v3.schema.json",
  "title": "Assessment plan v3 content-addressed provenance overlay",
  "description": "Validated together with assessment-plan/v1 after removing v3 provenance fields and substituting the v1 schema identifier.",
  "type": "object",
  "required": ["schema", "generator", "release_lock_digest"],
  "properties": {
    "schema": {"const": "compliance.example/assessment-plan/v3"},
    "generator": {"$ref": "#/$defs/generator"},
    "release_lock_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "generator": {
      "type": "object",
      "required": ["distribution", "version", "source_digest", "source_digest_algorithm", "artifact_sha256"],
      "additionalProperties": false,
      "properties": {
        "distribution": {"const": "compliance-tooling"},
        "version": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"},
        "source_digest_algorithm": {"const": "compliance.example/tooling-source-tree-digest/v1alpha1"},
        "artifact_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
