                              }
                            },
                            "policySources": {
                              "type": "array",
                              "minItems": 1,
                              "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "name",
                                  "content"
                                ],
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
                                  },
                                  "content": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                      "digest",
                                      "digestAlgorithm"
                                    ],
                                    "properties": {
                                      "digest": {
                                        "type": "string",
                                        "pattern": "^sha256:[0-9a-f]{64}$"
                                      },
                                      "digestAlgorithm": {
                                        "const": "compliance.example/policy-source-tree-digest/v1alpha1"
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        },
                        "digestAlgorithm": {
                          "const": "compliance.example/composition-lock-digest/v1alpha1"
                        },
                        "digest": {
                          "type": "string",
                          "pattern": "^sha256:[0-9a-f]{64}$"
                        }
