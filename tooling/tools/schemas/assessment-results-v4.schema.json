          "type": "object",
          "required": [
            "name",
            "version",
            "executableSha256"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "opa"
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
            },
            "executableSha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "evidence": {
          "type": "object",
          "required": [
            "documentDigestAlgorithm",
            "setDigestAlgorithm",
            "setDigest",
            "documents"
