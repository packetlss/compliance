  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reference": {
      "type": "string",
      "minLength": 3,
      "pattern": "^.+@.+$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "unknown",
        "not_applicable",
        "error",
        "waived"
      ]
    },
    "checkStatus": {
      "enum": [
        "pass",
        "fail",
        "unknown",
        "not_applicable",
        "error",
        "waived",
        "missing"
      ]
    },
    "externalRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resultSummary": {
      "type": "object",
      "required": [
        "pass",
        "fail",
        "unknown",
        "not_applicable",
        "error",
        "waived"
      ],
      "additionalProperties": false,
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "waived": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checkSummary": {
      "type": "object",
      "required": [
        "pass",
        "fail",
        "unknown",
        "not_applicable",
        "error",
        "waived",
        "missing"
      ],
      "additionalProperties": false,
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
