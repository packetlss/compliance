      "type": "object",
      "required": [
        "control_id",
        "instance_id",
        "subject_id",
        "plan_id",
        "inventory_revision",
        "assignment_revision",
        "status",
        "severity",
        "reason",
        "expected",
        "observed",
        "evidence_ids",
        "remediation",
        "external_refs",
        "alignment",
        "policy_revision"
