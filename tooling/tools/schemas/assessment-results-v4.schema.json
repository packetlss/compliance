{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/platform/assessment-results/v4.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "digestAlgorithm", "id", "plan_id", "subject_id", "evaluated_at", "outcome", "provenance", "dependency_dispositions", "results", "requirement_assessments", "requirement_baseline_assessments"],
  "properties": {
    "schema": {"const": "compliance.example/assessment-results/v4"},
    "digestAlgorithm": {"const": "compliance.example/assessment-results-digest/v1alpha1"},
    "id": {"$ref": "#/$defs/digest"},
    "plan_id": {"$ref": "#/$defs/digest"},
    "subject_id": {"$ref": "#/$defs/subjectId"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "outcome": {"$ref": "#/$defs/overallStatus"},
    "provenance": {"$ref": "#/$defs/evaluationProvenance"},
    "dependency_dispositions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/dependencyDisposition"}},
    "results": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/technicalOutcome"}},
    "requirement_assessments": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/requirementOutcome"}},
    "requirement_baseline_assessments": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/baselineOutcome"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "semanticId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$"},
    "slot": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "reference": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*@[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "subjectId": {"type": "string", "minLength": 3, "pattern": "^[^/]+/.+$"},
    "status": {"enum": ["pass", "fail", "unknown", "not_applicable", "error", "waived"]},
    "overallStatus": {"enum": ["pass", "fail", "unknown", "not_applicable", "error", "waived", "no_controls"]},
    "contentDigest": {
      "type": "object", "additionalProperties": false,
      "required": ["digest", "digestAlgorithm"],
      "properties": {"digest": {"$ref": "#/$defs/digest"}, "digestAlgorithm": {"type": "string", "minLength": 1}}
    },
    "enforcement": {
      "type": "object", "additionalProperties": false,
      "required": ["directExpectedContent", "compositionLock"],
      "properties": {
        "directExpectedContent": {"type": "object", "additionalProperties": {"$ref": "#/$defs/contentDigest"}},
        "compositionLock": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["expected", "digestAlgorithm", "digest"],
              "properties": {
                "expected": {"type": "object"},
                "digestAlgorithm": {"const": "compliance.example/composition-lock-digest/v1alpha1"},
                "digest": {"$ref": "#/$defs/digest"}
              }
            }
          ]
        }
      }
    },
    "compositionStage": {
      "type": "object", "additionalProperties": false,
      "required": ["actual", "compositionDigestAlgorithm", "compositionDigest", "enforcement"],
      "properties": {
        "actual": {"type": "object"},
        "compositionDigestAlgorithm": {"const": "compliance.example/composition-digest/v1alpha1"},
        "compositionDigest": {"$ref": "#/$defs/digest"},
        "enforcement": {"$ref": "#/$defs/enforcement"},
        "metadata": {"type": "object"}
      }
    },
    "evaluator": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "executableSha256"],
      "properties": {
        "name": {"const": "opa"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"},
        "executableSha256": {"$ref": "#/$defs/digest"}
      }
    },
    "evidenceSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["documentDigestAlgorithm", "setDigestAlgorithm", "setDigest", "documents"],
      "properties": {
        "documentDigestAlgorithm": {"const": "compliance.example/evidence-document-digest/v1alpha1"},
        "setDigestAlgorithm": {"const": "compliance.example/evidence-set-digest/v1alpha1"},
        "setDigest": {"$ref": "#/$defs/digest"},
        "documents": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "digest"],
            "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}
          }
        }
      }
    },
    "successfulSelection": {
      "type": "object", "additionalProperties": false,
      "required": ["instance_id", "dependency_id", "evidence_id", "evidence_digest", "collected_at"],
      "properties": {
        "instance_id": {"$ref": "#/$defs/semanticId"},
        "dependency_id": {"$ref": "#/$defs/slot"},
        "evidence_id": {"type": "string", "minLength": 1},
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "collected_at": {"type": "string", "format": "date-time"}
      }
    },
    "evaluationProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "evaluationComposition", "evaluator", "evidence", "selectedEvidence"],
      "properties": {
        "schema": {"const": "compliance.example/assessment-provenance/v1alpha1"},
        "evaluationComposition": {"$ref": "#/$defs/compositionStage"},
        "evaluator": {"$ref": "#/$defs/evaluator"},
        "evidence": {"$ref": "#/$defs/evidenceSnapshot"},
        "selectedEvidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/successfulSelection"}}
      }
    },
    "evidenceCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "evidence_digest", "collected_at"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "collected_at": {"type": "string", "format": "date-time"}
      }
    },
    "evidenceValidationDiagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "evidence_id", "evidence_digest", "schema_path", "keyword"],
      "properties": {
        "code": {"const": "evidence_schema_invalid"},
        "evidence_id": {"type": "string", "minLength": 1},
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "schema_path": {"type": "string", "pattern": "^(?:/|$)"},
        "keyword": {"type": "string", "minLength": 1}
      }
    },
    "dependencyDisposition": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["instance_id", "dependency_id", "disposition"],
          "properties": {
            "instance_id": {"$ref": "#/$defs/semanticId"},
            "dependency_id": {"$ref": "#/$defs/slot"},
            "disposition": {"const": "absent"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["instance_id", "dependency_id", "disposition", "latest_candidates"],
          "properties": {
            "instance_id": {"$ref": "#/$defs/semanticId"},
            "dependency_id": {"$ref": "#/$defs/slot"},
            "disposition": {"const": "stale"},
            "latest_candidates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceCandidate"}}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["instance_id", "dependency_id", "disposition", "diagnostics"],
          "properties": {
            "instance_id": {"$ref": "#/$defs/semanticId"},
            "dependency_id": {"$ref": "#/$defs/slot"},
            "disposition": {"const": "invalid"},
            "diagnostics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceValidationDiagnostic"}}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["instance_id", "dependency_id", "disposition", "candidates"],
          "properties": {
            "instance_id": {"$ref": "#/$defs/semanticId"},
            "dependency_id": {"$ref": "#/$defs/slot"},
            "disposition": {"const": "ambiguous"},
            "candidates": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceCandidate"}}
          }
        }
      ]
    },
    "observed": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "evidence_validation_errors": false,
        "evidence_selection_ambiguities": false
      }
    },
    "evaluationError": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["stage", "code"],
          "properties": {"stage": {"const": "criterion_execution"}, "code": {"const": "criterion_execution_failed"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["stage", "code"],
          "properties": {"stage": {"const": "criterion_decision"}, "code": {"enum": ["criterion_decision_invalid", "criterion_reported_error"]}}
        }
      ]
    },
    "appliedWaiver": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "digest", "subject_id", "instance_id", "valid_from", "expires_at", "rationale", "owner", "approval_ref", "approved_by", "approved_at", "underlying_status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "subject_id": {"$ref": "#/$defs/subjectId"},
        "instance_id": {"$ref": "#/$defs/semanticId"},
        "valid_from": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "rationale": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "approval_ref": {"type": "string", "minLength": 1},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"},
        "underlying_status": {"const": "fail"}
      }
    },
    "technicalOutcome": {
      "type": "object", "additionalProperties": false,
      "required": ["instance_id", "status", "reason", "expected", "observed"],
      "properties": {
        "instance_id": {"$ref": "#/$defs/semanticId"},
        "status": {"$ref": "#/$defs/status"},
        "reason": {"type": "string", "minLength": 1},
        "expected": {"type": "object"},
        "observed": {"$ref": "#/$defs/observed"},
        "evaluation_error": {"$ref": "#/$defs/evaluationError"},
        "waiver": {"$ref": "#/$defs/appliedWaiver"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "waived"}}, "required": ["status"]}, "then": {"required": ["waiver"]}, "else": {"not": {"required": ["waiver"]}}},
        {
          "if": {"properties": {"status": {"const": "error"}}, "required": ["status"]},
          "then": {
            "required": ["evaluation_error"],
            "properties": {"expected": {"maxProperties": 0}, "observed": {"maxProperties": 0}},
            "oneOf": [
              {"properties": {"evaluation_error": {"properties": {"code": {"const": "criterion_execution_failed"}}}, "reason": {"const": "Criterion execution failed."}}},
              {"properties": {"evaluation_error": {"properties": {"code": {"const": "criterion_decision_invalid"}}}, "reason": {"const": "Criterion decision was unusable."}}},
              {"properties": {"evaluation_error": {"properties": {"code": {"const": "criterion_reported_error"}}}, "reason": {"const": "Criterion reported an evaluation error."}}}
            ]
          },
          "else": {"not": {"required": ["evaluation_error"]}}
        }
      ]
    },
    "requirementOutcome": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement", "status", "reason"],
      "properties": {"requirement": {"$ref": "#/$defs/reference"}, "status": {"$ref": "#/$defs/status"}, "reason": {"type": "string", "minLength": 1}}
    },
    "baselineOutcome": {
      "type": "object", "additionalProperties": false,
      "required": ["baseline", "status", "reason"],
      "properties": {"baseline": {"$ref": "#/$defs/reference"}, "status": {"$ref": "#/$defs/status"}, "reason": {"type": "string", "minLength": 1}}
    }
  }
}
