            "compositionDigestAlgorithm",
            "compositionDigest",
            "enforcement"
          ]
        },
        "evaluationComposition": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actual": {
              "type": "object",
              "additionalProperties": false,
