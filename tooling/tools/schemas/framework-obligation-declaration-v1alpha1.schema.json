{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/platform/framework-obligation-declaration/v1alpha1.schema.json",
  "title": "Project-governed closed framework obligation declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "compliance.example/v1alpha1"},
    "kind": {"const": "FrameworkObligationDeclaration"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {"$ref": "#/$defs/spec"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "metadata": {"type": "object", "additionalProperties": false, "required": ["name", "revision", "owner", "review"], "properties": {
      "name": {"$ref": "#/$defs/id"}, "revision": {"$ref": "#/$defs/text"}, "owner": {"$ref": "#/$defs/text"}, "review": {"$ref": "#/$defs/review"}
    }},
    "review": {"type": "object", "additionalProperties": false, "required": ["reference", "approvedBy", "approvedAt"], "properties": {
      "reference": {"$ref": "#/$defs/text"}, "approvedBy": {"$ref": "#/$defs/text"}, "approvedAt": {"type": "string", "format": "date-time"}
    }},
    "groupRef": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"$ref": "#/$defs/id"}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["id", "description", "groupRefs"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "description": {"$ref": "#/$defs/text"}, "groupRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/groupRef"}}
    }},
    "pin": {"type": "object", "additionalProperties": false, "required": ["reference", "digest", "groupRefs"], "properties": {
      "reference": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*@[a-z0-9]+(?:[.-][a-z0-9]+)*$"}, "digest": {"$ref": "#/$defs/digest"}, "groupRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/groupRef"}}
    }},
    "governance": {"type": "object", "additionalProperties": false, "required": ["subject", "owner", "determination"], "properties": {
      "subject": {"$ref": "#/$defs/text"}, "owner": {"$ref": "#/$defs/text"}, "determination": {"enum": ["affirmative", "negative", "not_established"]}, "review": {"$ref": "#/$defs/review"}
    }},
    "basis": {"type": "object", "additionalProperties": false, "required": ["category"], "properties": {
      "category": {"enum": ["governance-declared", "evidence-assessed-objective", "direct-technical-policy", "mixed-governance-assessed", "external-judgment"]}, "governance": {"$ref": "#/$defs/governance"}, "objectivePins": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pin"}}, "directPolicyPins": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pin"}}, "externalReference": {"$ref": "#/$defs/text"}
    }},
    "obligation": {"type": "object", "additionalProperties": false, "required": ["id", "disposition", "interpretation", "basis"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "disposition": {"enum": ["applicable", "excluded", "not-applicable"]}, "interpretation": {"$ref": "#/$defs/text"}, "rationale": {"$ref": "#/$defs/text"}, "basis": {"$ref": "#/$defs/basis"}
    }},
    "spec": {"type": "object", "additionalProperties": false, "required": ["framework", "scope", "obligations"], "properties": {
      "framework": {"type": "object", "additionalProperties": false, "required": ["id", "profile", "version"], "properties": {"id": {"$ref": "#/$defs/text"}, "profile": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"}}},
      "scope": {"$ref": "#/$defs/scope"}, "obligations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/obligation"}}
    }}
  }
}
