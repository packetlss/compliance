{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/assessment-results-v3.schema.json",
  "title": "Assessment results v3 content-addressed execution provenance overlay",
  "description": "Validated together with assessment-results/v1 after removing v3 provenance fields and substituting the v1 schema identifier.",
  "type": "object",
  "required": ["schema", "generator", "release_lock_digest", "evaluator", "evidence"],
  "properties": {
    "schema": {"const": "compliance.example/assessment-results/v3"},
    "generator": {"$ref": "#/$defs/generator"},
    "release_lock_digest": {"$ref": "#/$defs/digest"},
    "evaluator": {
      "type": "object",
      "required": ["name", "version", "executableSha256"],
      "additionalProperties": false,
      "properties": {
        "name": {"const": "opa"},
        "version": {"$ref": "#/$defs/semver"},
        "executableSha256": {"$ref": "#/$defs/digest"}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["documentDigestAlgorithm", "setDigestAlgorithm", "setDigest", "documents"],
      "additionalProperties": false,
      "properties": {
        "documentDigestAlgorithm": {"const": "compliance.example/evidence-document-digest/v1alpha1"},
        "setDigestAlgorithm": {"const": "compliance.example/evidence-set-digest/v1alpha1"},
        "setDigest": {"$ref": "#/$defs/digest"},
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "digest"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "digest": {"$ref": "#/$defs/digest"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "generator": {
      "type": "object",
      "required": ["distribution", "version", "source_digest", "source_digest_algorithm", "artifact_sha256"],
      "additionalProperties": false,
      "properties": {
        "distribution": {"const": "compliance-tooling"},
        "version": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digest"},
        "source_digest_algorithm": {"const": "compliance.example/tooling-source-tree-digest/v1alpha1"},
        "artifact_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
