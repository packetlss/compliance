{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/releases/policy-source-release-manifest-v1.schema.json",
  "title": "Generic policy-source release manifest",
  "type": "object",
  "required": ["schema", "distribution", "version", "content"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "compliance.example/policy-source-release-manifest/v1"
    },
    "distribution": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "content": {
      "type": "object",
      "required": ["digest", "digestAlgorithm"],
      "additionalProperties": false,
      "properties": {
        "digest": {"$ref": "#/$defs/digest"},
        "digestAlgorithm": {
          "const": "compliance.example/policy-source-tree-digest/v1alpha1"
        }
      }
    },
    "sourceMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gitTag": {"type": "string", "minLength": 1},
        "gitCommit": {"$ref": "#/$defs/gitObjectId"}
      }
    },
    "representations": {
      "type": "array",
      "items": {"$ref": "#/$defs/archiveRepresentation"}
    }
  },
  "$defs": {
    "archiveRepresentation": {
      "type": "object",
      "required": ["kind", "format", "contentRoot", "filename", "sha256"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "archive"},
        "format": {"const": "compliance.example/policy-source-archive/v1"},
        "contentRoot": {"const": "policy"},
        "filename": {
          "type": "string",
          "pattern": "^(?!\\.{1,2}$)(?![A-Za-z]:)[^/\\\\\\u0000-\\u001f\\u007f]+$"
        },
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitObjectId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    }
  }
}
