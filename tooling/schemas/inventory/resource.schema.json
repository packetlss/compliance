{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compliance.example/schemas/inventory/resource-v1alpha1.schema.json",
  "title": "Compliance inventory resource",
  "oneOf": [
    {"$ref": "#/$defs/subject"},
    {"$ref": "#/$defs/inventoryGroup"},
    {"$ref": "#/$defs/policyAssignment"}
  ],
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "externalId", "observedAt"],
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "externalId": {"type": "string", "minLength": 1},
        "observedAt": {"type": "string", "format": "date-time"},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "localReference": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1}
      }
    },
    "subject": {
      "type": "object",
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "additionalProperties": true,
      "properties": {
        "apiVersion": {"const": "compliance.example/v1alpha1"},
        "kind": {"const": "Subject"},
        "metadata": {"$ref": "#/$defs/metadata"},
        "spec": {
          "type": "object",
          "required": ["id", "type", "lifecycle", "source"],
          "additionalProperties": true,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 3,
              "pattern": "^[^/]+/.+$"
            },
            "type": {"type": "string", "minLength": 1},
            "lifecycle": {
              "type": "string",
              "enum": ["active", "retired", "unknown"]
            },
            "source": {"$ref": "#/$defs/source"},
            "attributes": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "inventoryGroup": {
      "type": "object",
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "additionalProperties": true,
      "properties": {
        "apiVersion": {"const": "compliance.example/v1alpha1"},
        "kind": {"const": "InventoryGroup"},
        "metadata": {"$ref": "#/$defs/metadata"},
        "spec": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "parentRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/localReference"}
            },
            "selector": {
              "type": "object",
              "required": ["matchLabels"],
              "additionalProperties": true,
              "properties": {
                "matchLabels": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {"type": "string"}
                }
              }
            },
            "subjectRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": ["id"],
                "additionalProperties": false,
                "properties": {
                  "id": {"type": "string", "minLength": 3}
                }
              }
            }
          }
        }
      }
    },
    "policyAssignment": {
      "type": "object",
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "additionalProperties": true,
      "properties": {
        "apiVersion": {"const": "compliance.example/v1alpha1"},
        "kind": {"const": "PolicyAssignment"},
        "metadata": {"$ref": "#/$defs/metadata"},
        "spec": {
          "type": "object",
          "required": ["targetRef", "baselineRefs"],
          "additionalProperties": true,
          "properties": {
            "targetRef": {
              "type": "object",
              "required": ["kind", "name"],
              "additionalProperties": false,
              "properties": {
                "kind": {"const": "InventoryGroup"},
                "name": {"type": "string", "minLength": 1}
              }
            },
            "baselineRefs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": ["name", "revision"],
                "additionalProperties": false,
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "revision": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  }
}
